# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build outputs
dist/
build/
.next/
out/

# Testing
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Devpost media from tools/media
/media/

# Haunt Patrol (crew-app)
crew-app/data/*
!crew-app/data/.gitkeep
crew-app/.patrol/
crew-app/node_modules/
# ui/dist/index.mjs is a committed build artifact: a Crew install copies the app and builds nothing.
# Re-include the folder that the generic dist/ rule above excludes. The patrol's static fallback
# files in ui/dist/data/ are runtime output and stay ignored.
!crew-app/ui/dist/
crew-app/ui/dist/data/

# Production build that `npm run serve:ghosts` serves for ghost runs
.ghost-build/
